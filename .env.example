# AI Interviewer configuration template.
#
#   cp .env.example .env      # then edit .env; never commit it
#   npm run doctor            # checks config and local tools; never prints keys
#
# Blank values use the defaults shown. Everything here is read by the API
# server only; nothing is sent to the browser.

# --- Local API server ---------------------------------------------------------
# Bind to loopback so the API is not reachable from your network.
HOST=127.0.0.1
PORT=3001

# --- Speech-to-text provider selection ----------------------------------------
# elevenlabs | whisper-local | fake   (fake = deterministic demo text, no audio processing)
STT_PROVIDER=elevenlabs
# elevenlabs | whisper-local | fake | none   (must differ from STT_PROVIDER)
# Used on missing credentials, quota/rate limits, network errors, timeouts, and
# provider failures. Never used for invalid audio.
STT_FALLBACK_PROVIDER=whisper-local

# --- ElevenLabs Scribe (cloud) ------------------------------------------------
# Your own key from https://elevenlabs.io (Profile -> API keys). Server-side only.
# Leave blank to run without ElevenLabs; the fallback or typed answers still work.
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_STT_TIMEOUT_MS=30000
# Adds tags like "(laughter)" to transcripts. Off so tags do not become answer text.
ELEVENLABS_TAG_AUDIO_EVENTS=false
# Verbatim fillers ("um", "uh") are always kept: no_verbatim is never sent.
# Paid keyterm prompting is never requested.

# --- whisper.cpp (local, open-source fallback) --------------------------------
# Nothing is downloaded automatically. Install whisper.cpp and ffmpeg yourself,
# then point these at them. A bare command name (no slash) is looked up on PATH;
# relative paths are resolved from the repository root.
WHISPER_CLI_PATH=whisper-cli
# Recommended English default: ggml-small.en.bin (~465 MB).
# Optional higher quality, slower: ggml-medium.en.bin (~1.5 GB).
WHISPER_MODEL_PATH=./models/whisper/ggml-small.en.bin
# Spoken language passed to whisper-cli -l. English-only (*.en.bin) models need "en".
WHISPER_LANGUAGE=en
# Optional CPU thread count for whisper-cli (-t); blank uses whisper.cpp's default.
WHISPER_THREADS=
WHISPER_TIMEOUT_MS=120000
# ffmpeg converts browser WebM/MP4/Ogg/WAV to 16 kHz mono WAV for whisper.cpp.
FFMPEG_PATH=ffmpeg
FFMPEG_TIMEOUT_MS=20000

# --- Upload limits ------------------------------------------------------------
MAX_AUDIO_UPLOAD_MB=10
MAX_UTTERANCE_SECONDS=60

# --- End-to-end interview pipeline -------------------------------------------
# deterministic is fully offline and is the default. ollama is reserved for a
# local coaching adapter; no cloud LLM or OpenAI-compatible runtime is used.
LLM_PROVIDER=deterministic
LLM_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_TIMEOUT_MS=60000

# Resume text is processed in memory into bounded professional signals only.
RESUME_MAX_MB=5
RESUME_MAX_CHARS=40000
RESUME_MAX_PDF_PAGES=10

# Optional spoken questions: none | say | espeak | spd-say
CLI_TTS_PROVIDER=none
CLI_TTS_COMMAND=
CLI_TTS_TIMEOUT_MS=30000

INTERVIEW_DEFAULT_QUESTIONS=3
INTERVIEW_DEFAULT_MINUTES=5
INTERVIEW_MAX_FOLLOWUPS_PER_QUESTION=1
INTERVIEW_SESSIONS_DIR=./data/sessions
